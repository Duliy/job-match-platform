# =============================================================
#  招聘信息采集平台 - systemd 服务文件
#
#  安装方法：
#    sudo cp job-board-api.service /etc/systemd/system/
#    sudo cp job-board-web.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable job-board-api job-board-web
#    sudo systemctl start  job-board-api job-board-web
#
#  查看状态：sudo systemctl status job-board-api
#  查看日志：sudo journalctl -u job-board-api -f
# =============================================================

[Unit]
Description=招聘采集平台 - Flask API
After=network.target

[Service]
Type=simple
# ⚠️ 修改为实际部署路径和用户
WorkingDirectory=/opt/job-board
ExecStart=/usr/bin/python3 /opt/job-board/schedule_api.py
Restart=always
RestartSec=5
User=www-data
Environment=PYTHONUNBUFFERED=1
Environment=ADMIN_PASSWORD=admin123
# 日志会进 journalctl
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
